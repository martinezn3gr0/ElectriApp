# ElectriApp environment
PORT=3000
NODE_ENV=development

# Resend (completion emails)
RESEND_API_KEY=
# Optional verified sender, e.g. "ElectriApp <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=

# Firebase Admin — required for /api/submit-review and privileged writes
# Paste the full service account JSON as a single-line string:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or point to a credentials file instead:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# Comma-separated browser origins allowed to call the API (required in production)
# Example: https://your-app.web.app,https://your-custom-domain.com
CORS_ORIGINS=
