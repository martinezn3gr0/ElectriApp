{
  "entities": {
    "User": {
      "title": "User Profile (private)",
      "description": "Private profile including email. Owner-only reads.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["electrician", "client"] },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "certifications": { "type": "array", "items": { "type": "string" } },
        "availability": { "type": "string", "enum": ["available", "busy", "offline"] },
        "yearsOfExperience": { "type": "integer" },
        "location": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "acceptedTerms": { "type": "boolean" },
        "acceptedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "acceptedTerms", "acceptedAt"]
    },
    "PublicProfile": {
      "title": "Public Profile",
      "description": "Marketplace card without email or terms fields.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["electrician", "client"] },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "certifications": { "type": "array", "items": { "type": "string" } },
        "availability": { "type": "string", "enum": ["available", "busy", "offline"] },
        "yearsOfExperience": { "type": "integer" },
        "location": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "createdAt"]
    },
    "Project": {
      "title": "Project Lead",
      "description": "A job opportunity posted by a client.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "budget": { "type": "number" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "completed", "cancelled"] },
        "clientId": { "type": "string" },
        "electricianId": { "type": "string" },
        "category": { "type": "string", "enum": ["residential", "commercial", "industrial", "emergency"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "clientId", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Client feedback for an electrician. Written only via Admin SDK.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "clientId": { "type": "string" },
        "electricianId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ratingApplied": { "type": "boolean" }
      },
      "required": ["projectId", "clientId", "electricianId", "rating"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Communication between client and electrician on a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "senderId", "receiverId", "text"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Private user profiles (PII)"
    },
    "/publicProfiles/{uid}": {
      "schema": "PublicProfile",
      "description": "Public marketplace profiles (no email)"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project listings"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Project reviews"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Direct messages"
    }
  }
}
